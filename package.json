{
  "name": "walletguard-cre",
  "version": "0.1.0",
  "private": true,
  "description": "Chainlink CRE-powered transaction analysis with x402 payments",
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "overrides": {
      "zod": "3.22.4"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "cre-compile-workflow": "bun ./cre-compile-workflow",
    "fixtures:update-baseline": "bun scripts/simulate-workflow-fixtures.ts --update-baseline",
    "fixtures:check-baseline": "bun scripts/simulate-workflow-fixtures.ts --check-baseline",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
